{
  "listen": ":8080",
  "db": "uptime.db",
  "base_url": "",
  "signup": "closed",
  "allow_private_targets": "operator",
  "failure_threshold": 2,
  "interval": "30s",
  "timeout": "10s",
  "retention": "720h",
  "limits": {"max_monitors": 20, "min_interval": "30s", "max_workspaces": 0, "signups_per_hour": 100, "mail_per_hour": 500, "mail_per_day": 0, "host_requests_per_second": 1},
  "targets": [
    { "name": "Example", "url": "https://example.com" },
    { "name": "Go dev", "url": "https://go.dev", "interval": "60s", "keyword": "Go" },
    { "name": "Health API", "url": "https://httpbin.org/status/200", "expect_status": 200 }
  ],
  "notify": {
    "telegram": { "bot_token": "${TELEGRAM_BOT_TOKEN}", "chat_id": "${TELEGRAM_CHAT_ID}" }
  }
}
